# アプリ独自の設定名。値はコミットしない。未設定項目は doctor が BLOCKED を返す。

# --- Firebase（未設定時はモック匿名認証） ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
# サーバー認証は ADC またはローカル資格情報パス。資格情報をコミットしない
GOOGLE_APPLICATION_CREDENTIALS=

# --- OrcaRouter（未設定時はモック推論。LIVE では必須） ---
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
ORCAROUTER_API_KEY=
# ダッシュボードで作成した Named Router。未作成なら直接モデル ID（例 openai/gpt-4o-mini）
ORCAROUTER_MUNDANE_MODEL=orcarouter/mundane
ORCAROUTER_HARD_MODEL=orcarouter/hard

# --- Google Maps Platform（Places New / Routes）。未設定時はモックカタログ ---
GOOGLE_MAPS_API_KEY=

# --- デモ ---
ENABLE_DEMO_CONTROLS=true
DEMO_ALLOWED_UIDS=
DEMO_AREA_NAME=名古屋駅周辺
DEMO_LAT=35.170915
DEMO_LNG=136.881537
DEMO_DATE=2026-09-19
WORKER_CONCURRENCY=1

# モック実行（既定）。LIVE はキーが揃い APP_RUNTIME=LIVE のときのみ
APP_RUNTIME=MOCK
MOCK_AUTH_SECRET=dev-only-change-me
