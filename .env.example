# アプリ独自の設定名。値はコミットしない。未設定項目は doctor が BLOCKED を返す。

# --- Firebase ---
# Cloud Agent / ローカル開発は Emulator（Google ログイン不要）
USE_FIREBASE_EMULATOR=true
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_PROJECT_ID=demo-futari-log
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-futari-log
NEXT_PUBLIC_FIREBASE_API_KEY=fake-api-key-for-emulator
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
NEXT_PUBLIC_FIREBASE_APP_ID=1:0:web:emulator
DATA_BACKEND=firestore
# 検証用の分割コレクション接頭辞。本番データへは付けない。未設定が本番コレクション。
# FIRESTORE_NAMESPACE=localverify20260920
# 旧単一ドキュメント。移行元の読み取り専用。アプリはもう書き込まない。
# FIRESTORE_ROOT_DOC=sys/root

# Cloud Run は手元 PC で `npm run deploy:cloudrun`（PROJECT_ID=futari-log-agent）。
# 秘密は .env.local のみ。スクリプトが Secret Manager へ入れる。USE_FIREBASE_EMULATOR は外す。
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# FIREBASE_PROJECT_ID=
# サーバー認証は Cloud Run の ADC。資格情報ファイルはコミットしない
# GOOGLE_APPLICATION_CREDENTIALS=
# FIREBASE_SERVICE_ACCOUNT_JSON=

# --- OrcaRouter（未設定時はモック推論。LIVE では必須） ---
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
ORCAROUTER_API_KEY=
ORCAROUTER_MUNDANE_MODEL=orcarouter/futari-mundane
ORCAROUTER_HARD_MODEL=orcarouter/futari-hard

# --- Google Maps Platform（Places New / Routes）。未設定時はモックカタログ ---
GOOGLE_MAPS_API_KEY=

# --- Gemini Web Grounding（スポット写真。生成画像ではない） ---
# 既定は ORCAROUTER_API_KEY 経由。googleSearch を Gemini の Grounding に翻訳する
# https://docs.orcarouter.ai/advanced/web-search
# GEMINI_API_KEY は Google 直結の任意上書き。無くてよい
# GEMINI_MODEL=google/gemini-3.5-flash

# --- デモ ---
ENABLE_DEMO_CONTROLS=true
# LIVE では UID をカンマ区切り。ローカル確認のみなら * で全 UID を許可
DEMO_ALLOWED_UIDS=
DEMO_AREA_NAME=東京駅周辺
DEMO_LAT=35.681236
DEMO_LNG=139.767125
# 実行日（Asia/Tokyo）。未設定または過去日は当日に読み替える。未来日だけ明示する
# DEMO_DATE=
# 大会カレンダーのサンプル振り返りステッカー（表示のみ。Firestore / 計画 / 記憶には入れない）
# DEMO_CALENDAR_STICKERS=true
# DEMO_CALENDAR_ANCHOR_DATE=2026-09-21
# ローカル production build 用（任意。通常はサーバー側 DEMO_CALENDAR_STICKERS で足りる）
# NEXT_PUBLIC_DEMO_CALENDAR_STICKERS=true
# NEXT_PUBLIC_DEMO_CALENDAR_ANCHOR_DATE=2026-09-21
WORKER_CONCURRENCY=1

# イベント事前収集（UIは未接続。バックエンドのみ）
# ENABLE_EVENT_CATALOG=false
# ORCAROUTER_SEARCH_MODEL=google/gemini-2.5-flash
# INGEST_MAX_EVENTS=10
# Scheduler は OIDC。鍵ファイルは使わない
# INGEST_OIDC_AUDIENCE=
# INGEST_OIDC_SERVICE_ACCOUNT=

# Cloud Run LIVE では PLAN_ORCHESTRATOR=workflows。ローカルは worker
# PLAN_ORCHESTRATOR=worker
# WORKFLOW_NAME=futari-propose
# WORKFLOW_LOCATION=asia-northeast1
# PUBLIC_BASE_URL=
# WORKFLOW_INVOKE_SECRET=

# UI 専用 fixture（npm run dev:ui）。LIVE / Cloud Run には載せない
# NEXT_PUBLIC_USE_API_FIXTURES=true
# NEXT_PUBLIC_APP_RUNTIME=MOCK

# モック実行（既定）。LIVE は実キーが揃い APP_RUNTIME=LIVE かつ Emulator ではないときのみ
APP_RUNTIME=MOCK
MOCK_AUTH_SECRET=dev-only-change-me

# Cloud Run は PORT を渡す。COOKIE_SECURE は HTTPS で自動（K_SERVICE）
# PORT=8080
# COOKIE_SECURE=true
