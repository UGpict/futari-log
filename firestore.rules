rules_version = '2';
// クライアントからの write は拒否。サーバー（Admin SDK / Cloud Run）だけが書き込む。
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(coupleId) {
      return signedIn() &&
        get(/databases/$(database)/documents/couples/$(coupleId)).data.ownerUid == request.auth.uid;
    }

    match /couples/{coupleId} {
      allow read: if isOwner(coupleId);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if false;

      match /{document=**} {
        allow read: if isOwner(coupleId);
        allow write: if false;
      }
    }

    // カタログは Admin SDK のみ。sys/root には載せない。
    match /catalogEvents/{id} {
      allow read, write: if false;
    }
    match /catalogVenues/{id} {
      allow read, write: if false;
    }
    match /catalogIngestRuns/{id} {
      allow read, write: if false;
    }
  }
}
